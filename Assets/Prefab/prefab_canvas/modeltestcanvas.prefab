  m_text: "\u540D\u79F0\uFF1A\u91D1\u9762\u7F69\u9752\u94DC\u4EBA\u5934\u50CF\r\n\u5E74\u4EE3\uFF1A\u5546\u4EE3\u665A\u671F\uFF08\u7EA6\u516C\u5143\u524D1300-1000\u5E74\uFF09\r\n\u51FA\u571F\u5730\uFF1A\u56DB\u5DDD\u5E7F\u6C49\u4E09\u661F\u5806\u9057\u57402\u53F7\u796D\u7940\u5751\uFF081986\u5E74\u51FA\u571F\uFF09\r\n\u73B0\u85CF\uFF1A\u4E09\u661F\u5806\u535A\u7269\u9986\r\n\u7279\u5F81\u4E0E\u4EF7\u503C\r\n     
    \u9752\u94DC\u5934\u50CF\u9AD8\u9F3B\u6DF1\u76EE\u3001\u5927\u8033\u62DB\u98CE\uFF0C\u9762\u90E8\u8986\u76D6\u8584\u5982\u8749\u7FFC\u7684\u91D1\u7B94\u9762\u7F69\uFF0C\u53CC\u7709\u3001\u53CC\u773C\u53CA\u5634\u90E8\u9542\u7A7A\uFF0C\u5DE5\u827A\u6781\u4E3A\u7CBE\u6E5B\u3002\u5728\u5DF2\u53D1\u73B0\u768457\u4EF6\u9752\u94DC\u4EBA\u5934\u50CF\u4E2D\uFF0C\u4EC54\u4EF6\u4F69\u6234\u91D1\u9762\u7F69\uFF0C\u8C61\u5F81\u4F69\u6234\u8005\u5C0A\u8D35\u3001\u6743\u5A01\u7684\u8EAB\u4EFD\uFF0C\u53EF\u80FD\u662F\u53E4\u8700\u56FD\u8D35\u65CF\u6216\u9AD8\u7EA7\u796D\u53F8\u3002\u91D1\u9762\u7F69\u4E5F\u88AB\u8BA4\u4E3A\u662F\u901A\u795E\u7684\u6CD5\u5177\uFF0C\u5177\u6709\u5B97\u6559\u796D\u7940\u610F\u4E49\u3002\r\n     
    \u8FD9\u4EF6\u6587\u7269\u662F\u7814\u7A76\u53E4\u8700\u6587\u660E\u5B97\u6559\u89C2\u5FF5\u3001\u7B49\u7EA7\u5236\u5EA6\u548C\u5236\u91D1\u5DE5\u827A\u7684\u73CD\u8D35\u5B9E\u7269\uFF0C\u8BC1\u660E\u53E4\u8700\u6587\u660E\u662F\u4E2D\u534E\u6587\u660E\u591A\u5143\u4E00\u4F53\u683C\u5C40\u7684\u91CD\u8981\u7EC4\u6210\u90E8\u5206\u3002"
